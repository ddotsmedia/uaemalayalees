# Database
DATABASE_URL="postgresql://user:password@localhost:5432/uaemalayalees"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"

# Resend (Email OTP)
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Twilio (Phone OTP)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+1234567890"

# Cloudflare R2
R2_ACCOUNT_ID="xxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxx"
R2_BUCKET_NAME="uaemalayalees-media"
R2_PUBLIC_URL="https://media.uaemalayalees.com"

# Vercel
VERCEL_ENV="development"
